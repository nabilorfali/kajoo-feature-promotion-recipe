{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": { "const": 1 },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "readmeUri": { "type": "string", "minLength": 1 },
          "hiddenCreatedAt": { "type": "string", "minLength": 1 },
          "madePublicAt": { "type": ["string", "null"] }
        },
        "required": ["slug", "readmeUri", "hiddenCreatedAt", "madePublicAt"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "entries"],
  "additionalProperties": false
}
