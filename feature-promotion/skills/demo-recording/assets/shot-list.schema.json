{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": { "const": 1 },
    "entry": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "pattern": "^https://" },
    "targetSeconds": { "type": "number", "minimum": 5, "maximum": 90 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "shows": { "type": "string", "minLength": 1 },
          "caption": { "type": "string", "minLength": 1 }
        },
        "required": ["shows", "caption"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "entry", "title", "environment", "steps"],
  "additionalProperties": false
}
